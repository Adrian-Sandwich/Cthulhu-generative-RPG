# Export these variables in your shell, or set them as secrets/env on your host.
# app.py does not automatically load a .env file.

# --- LLM provider ---------------------------------------------------------
# Local dev default is Ollama (leave unset). For production use a hosted API:
LLM_PROVIDER=openai                                  # openai | ollama
LLM_BASE_URL=https://api.groq.com/openai/v1          # Groq (OpenAI-compatible)
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=                                         # your Groq API key (SECRET)

# --- Multi-backend pool (self-hosted Ollama across machines) --------------
# Spread load over several GPUs with least-busy routing + failover. Optional
# per-endpoint model with url@model (fast box vs slow box).
# LLM_ENDPOINTS=http://192.168.1.50:11434@qwen2.5:14b,http://127.0.0.1:11434@mistral
# LLM_MAX_PARALLEL=2                                  # concurrent calls per endpoint

# --- Web server -----------------------------------------------------------
HOST=0.0.0.0
PORT=8080
FLASK_DEBUG=0
# Empty by default: use socket IP for rate limits. Set only the actual proxy
# addresses/CIDRs; X-Forwarded-For is walked right-to-left through trusted hops.
# TRUSTED_PROXIES=127.0.0.1/32,::1/128
SECRET_KEY=                                          # openssl rand -hex 32 (SECRET, stable!)

# --- Persistence ----------------------------------------------------------
DATA_DIR=/data                                       # mount a volume here in prod
# Optional shared persistence. Unset keeps JSON saves and requires one process.
# CTHULHU_DATABASE_URL=postgresql://user:password@host/database
# SECRET_KEY must be identical on every PostgreSQL-backed server.
# WEB_CONCURRENCY=2                                  # only with PostgreSQL
# PG_POOL_SIZE=4                                     # short-operation connections per worker; 0 disables reuse
# PG_POOL_TIMEOUT=2                                  # seconds waiting for a short-operation connection
# LLM_QUEUE_TIMEOUT=2                                # seconds waiting for an endpoint permit
# Initialize/import explicitly: python tools/migrate_postgres.py --help

# --- Content moderation ---------------------------------------------------
# MODERATION=local                                   # local (default) | off | api
# MODERATION_EXTRA=                                  # comma-separated extra local blocklist terms
# MODERATION_URL=                                    # override /moderations endpoint when MODERATION=api
# MODERATION_MODEL=                                  # default: omni-moderation-latest

# --- Admin dashboard -------------------------------------------------------
# REQUEST_TIMING=1                                   # JSON request timings; no prompts/cookies/query strings
# ADMIN_TOKEN=                                       # token for /admin?token=... (SECRET; unset = disabled)
# EXCLUDE_NAMES=                                     # comma-separated player names hidden from stats

# --- Optional subsystems (off by default) ---------------------------------
# ENABLE_ENTITY_GRAPH=1                              # needs Neo4j + requirements-optional
# NEO4J_PASSWORD=                                    # Neo4j auth (default: "password", local dev only)
# ENABLE_IMAGES=1                                    # needs torch/diffusers (GPU)
# CORS_ORIGINS=https://yourfrontend.example          # only if serving cross-origin
