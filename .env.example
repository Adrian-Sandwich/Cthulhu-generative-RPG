# Copy to .env for local dev, or set these as secrets/env on your host.

# --- LLM provider ---------------------------------------------------------
# Local dev default is Ollama (leave unset). For production use a hosted API:
LLM_PROVIDER=openai                                  # openai | ollama
LLM_BASE_URL=https://api.groq.com/openai/v1          # Groq (OpenAI-compatible)
LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=                                         # your Groq API key (SECRET)

# --- Web server -----------------------------------------------------------
HOST=0.0.0.0
PORT=8080
FLASK_DEBUG=0
SECRET_KEY=                                          # openssl rand -hex 32 (SECRET, stable!)

# --- Persistence ----------------------------------------------------------
DATA_DIR=/data                                       # mount a volume here in prod

# --- Optional subsystems (off by default) ---------------------------------
# ENABLE_ENTITY_GRAPH=1                              # needs Neo4j + requirements-optional
# ENABLE_IMAGES=1                                    # needs torch/diffusers (GPU)
# CORS_ORIGINS=https://yourfrontend.example          # only if serving cross-origin
